#!/usr/bin/env bash
set -e -u -o pipefail

# Resolve canonical script location (traversing symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd -P "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<EOF
k0maru-skills CLI - Manage personal agent skills

Usage:
  k0maru-skills <command>

Commands:
  list, ls         List all available skills and their categories
  sync             Sync/link all skills to all agent environments
  doctor, check    Check external dependencies and health status (-i for interactive TUI)
  install-deps     Launch interactive TUI to select and install companion packages
  dir, path        Print the repository directory path
  open             Open the skills repository in file manager
  help, -h         Show this help message

Agent Targets:
  - Universal Agent Skills: ~/.agents/skills/
  - Antigravity / Gemini:   ~/.gemini/config/skills/
  - Claude Code:            ~/.claude/skills/
EOF
}

cmd="${1:-help}"

case "$cmd" in
  list|ls)
    "$REPO_DIR/scripts/sync.sh" --list
    ;;
  sync)
    shift || true
    "$REPO_DIR/scripts/sync.sh" "$@"
    ;;
  doctor|check)
    shift || true
    "$REPO_DIR/scripts/check-deps.sh" "$@"
    ;;
  install-deps|install)
    "$REPO_DIR/scripts/check-deps.sh" -i
    ;;
  dir|path)
    echo "$REPO_DIR"
    ;;

  open)
    open "$REPO_DIR"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
